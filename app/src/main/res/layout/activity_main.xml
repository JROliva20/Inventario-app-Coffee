<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/blanco"
    android:padding="20dp">

<ImageView
    android:layout_width="200dp"
    android:layout_height="100dp"
    android:layout_gravity="center"
    android:layout_marginTop="10dp"
    android:src="@drawable/logocafe"
    android:contentDescription="Logo"/>

<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Inventario Corral"
    android:textSize="40sp"
    android:textStyle="bold"
    android:textColor="@color/cafe_oscuro"
    android:layout_gravity="center"
    android:layout_marginTop="15dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnProductos"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Ver Productos"
        app:icon="@drawable/icon_check"
        app:iconTint="@color/blanco"
        app:backgroundTint="@color/cafe_oscuro"
        android:textColor="@color/blanco"
        android:layout_gravity="center"
        android:layout_marginTop="40dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAggProducto"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Agregar Producto"
        app:icon="@drawable/agg"
        app:iconTint="@color/blanco"
        app:backgroundTint="@color/cafe_oscuro"
        android:textColor="@color/blanco"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEditarproducto"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Editar Producto"
        app:icon="@drawable/edit"
        app:iconTint="@color/blanco"
        app:backgroundTint="@color/cafe_oscuro"
        android:textColor="@color/blanco"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEliminarproducto"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Eliminar Producto"
        app:icon="@drawable/delete"
        app:iconTint="@color/blanco"
        app:backgroundTint="@color/cafe_oscuro"
        android:textColor="@color/blanco"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnInfo"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Acerca de"
        app:icon="@drawable/info"
        app:iconTint="@color/blanco"
        app:backgroundTint="@color/cafe_oscuro"
        android:textColor="@color/blanco"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSalir"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Salir"
        app:icon="@drawable/exit"
        app:iconTint="@color/blanco"
        app:backgroundTint="@color/cafe_oscuro"
        android:textColor="@color/blanco"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"/>

</LinearLayout>
