<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/crema_fondo"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recetas externas"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@color/verde_principal"
        android:gravity="center"
        android:layout_marginTop="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Explora nuevas recetas"
        android:textSize="17sp"
        android:textColor="@color/verde_secundario"
        android:gravity="center"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="18dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilBuscarReceta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Buscar receta"
        android:textColorHint="@color/verde_claro"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxStrokeColor="@color/verde_principal"
        app:hintTextColor="@color/verde_secundario"
        app:startIconDrawable="@drawable/iconobuscar"
        app:startIconTint="@color/verde_principal">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etBuscarReceta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/verde_claro"
            android:textColorHint="@color/verde_claro"
            android:imeOptions="actionSearch"/>

    </com.google.android.material.textfield.TextInputLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRecetas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="15dp"
        android:clipToPadding="false"
        android:paddingBottom="10dp" />

    <TextView
        android:id="@+id/tvSinResultados"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No se encontraron recetas"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/verde_secundario"
        android:gravity="center"
        android:visibility="gone"
        android:padding="20dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRegresar"
        style="@style/Widget.Material3.Button.TextButton.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Regresar"
        android:textSize="16sp"
        android:textColor="@color/verde_principal"
        app:icon="@drawable/iconoatras"
        app:iconTint="@color/verde_principal" />

</LinearLayout>